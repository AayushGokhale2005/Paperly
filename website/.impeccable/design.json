  "narrative": {
    "northStar": "The Open Product Desk",
    "overview": "Paperly's public website is modern, spacious, and direct. White and cool pale-blue fields give the original native-app screenshots room to explain the product. Near-black Geist typography and electric-blue actions make the reading and install paths easy to follow.\n\nThis direction comes from the user's explicit requests and supplied product imagery. It is not an approved generated comp or an externally verified quality-bar reference. This document governs the Vite website only; the native app has its own design system.",
    "keyCharacteristics": [
      "Real README screenshots and the supplied Paperly logo.",
      "Large, closely tracked headings and concise supporting copy.",
      "Rectangular controls with selectively rounded navigation and screenshots.",
      "Quiet motion and readable preference-based fallbacks."
    ],
    "rules": [
      {
        "name": "The Action Blue Rule",
        "body": "Reserve the accent for actionable or emphasized content; use neutral rules and pale fields for structure.",
        "section": "colors"
      },
      {
        "name": "The Product Depth Rule",
        "body": "Give depth to the actual product imagery and navigation; keep prose sections open and separated by thin rules.",
        "section": "elevation"
      },
      {
        "name": "The Selective Rounding Rule",
        "body": "Preserve the rounded glass navigation and screenshot frames without turning buttons, labels, or tabs into pills.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** use real README screenshots and concise image descriptions.",
      "**Do** preserve the responsive navigation and screenshot radius tokens.",
      "**Do** keep primary actions rectangular and blue.",
      "**Do** retain keyboard controls, visible focus, and motion/transparency fallbacks."
    ],
    "donts": [
      "**Don't** turn buttons, tabs, or platform labels into pills.",
      "**Don't** replace native screenshots with fabricated interfaces or mock device frames.",
      "**Don't** add continuous decorative motion or repeated section reveals.",
      "**Don't** promote the website's glass treatment into the native app's design system."
    ]
  }
